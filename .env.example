MONGODB_URI=
MONGODB_DB=explainer-db

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_SCALE=

# Sales inbox for the Enterprise “聯絡我們” mailto
NEXT_PUBLIC_SALES_EMAIL=

# 1 = new accounts lock a permanent subscription discount and the site shows the offer banner.
# 0 = new accounts do not get that discount. Accounts that already locked it keep it.
SIGNUP_PROMO_ENABLED=1
# How many 折 that locked discount is. 85 = 八五折 (pay 85% of list). Only applied to accounts created while the promo is on.
SIGNUP_PROMO_FOLD=85
# Extra percent of credits added when buying an adhoc pack. 0 turns the bonus off. The charge stays the list price.
ADHOC_CREDIT_BONUS_PERCENT=5

HF_CREDENTIALS=
HF_API_KEY_ID=
HF_API_KEY_SECRET=
HF_WEBHOOK_SECRET=

# OpenRouter image + clip video. Webhook secret must match the workspace signing secret.
OPENROUTER_API_KEY=
OPENROUTER_WEBHOOK_SECRET=
# Clip video generation resolution (e.g. 720p, 1080p, 2K). Defaults to 720p.
VIDEO_GENERATION_RESOLUTION=720p

# DashScope / 阿里雲百煉 — when set, image + clip video go here instead of Higgsfield
ALICLOUD_API_KEY=

BLOB_READ_WRITE_TOKEN=

# ElevenLabs — clones a character's demo voice and re-voices clips to it
ELEVENLABS_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Freesound OAuth. Redirect URL:
# https://scro.io/_freesound/app_permissions/permission_granted
FREESOUND_CLIENT_ID=
FREESOUND_CLIENT_SECRET=

# Google AI Studio (Gemini) powers the storyboard director
GOOGLE_GENERATIVE_AI_API_KEY=
# Nano Banana Pro stills (gemini-3-pro-image) use this AI Studio key
GOOGLE_API_KEY=
OPENAI_API_KEY=
DIRECTOR_MODEL=gemini-3.8-flash
# End-still rewrite. Defaults to the same model as the storyboard.
END_SCENE_MODEL=gemini-3.8-flash

# SendLayer SMTP — finish mail for frames / clip videos / character sheets
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
